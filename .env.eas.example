# Copy to .env.eas and fill in. tools/eas.sh sources it before every eas command,
# so nothing needs sourcing by hand.
#
# These three make eas-cli authenticate with Apple using an App Store Connect API
# key. Without them it asks for an Apple ID password and a 2FA code by SMS, which
# Apple frequently fails to deliver.
#
# Create the key in App Store Connect under Users and Access > Integrations >
# App Store Connect API > Team Keys, with the Admin role. The .p8 downloads once
# and cannot be downloaded again.

# Path to the .p8, relative to the project root. credentials/ is gitignored.
EXPO_ASC_API_KEY_PATH=credentials/asc-api-key.p8
# Key ID: 10 characters, in the key list next to the name. Example: A12345BCD6
EXPO_ASC_KEY_ID=
# Issuer ID: a UUID above the key list, shared by every key on the team.
# It is NOT the Key ID. Example: 69a6de7a-1234-47e3-e053-5b8c7c11a4d1
EXPO_ASC_ISSUER_ID=

# Apple team, pinned so eas never asks. With an API key eas-cli cannot read the
# team type from Apple, so it prompts, and Enterprise sits first in that list.
# Picking it makes eas request an IOS_APP_INHOUSE provisioning profile, which
# Apple refuses with a 403 about program membership. Only IN_HOUSE changes the
# profile type; INDIVIDUAL and COMPANY_OR_ORGANIZATION behave the same.
EXPO_APPLE_TEAM_ID=
EXPO_APPLE_TEAM_TYPE=INDIVIDUAL
